{
	"name": "n8n-nodes-telzino-ai",
	"version": "0.1.1",
	"description": "n8n community node for the Telzino AI voice agent platform: trigger workflows from call events and place outbound AI voice calls.",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"telzino",
		"voice",
		"ai-agent",
		"telephony"
	],
	"license": "MIT",
	"homepage": "https://docs.telzino.com",
	"author": {
		"name": "Telzino",
		"email": "support@telzino.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Telimatic/telzino-n8n-node.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier nodes credentials --write",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TelzinoApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Telzino/Telzino.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.37.2",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
